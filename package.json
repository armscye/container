{
  "name": "@armscye/container",
  "version": "0.8.2",
  "description": "Common TypeScript types for dependency injection containers.",
  "keywords": [
    "armscye",
    "typescript",
    "types",
    "container",
    "dependency-injection"
  ],
  "homepage": "https://github.com/armscye/container#readme",
  "bugs": {
    "url": "https://github.com/armscye/container/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armscye/container.git"
  },
  "license": "MIT",
  "author": "Augustus Kamau",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check:package": "pnpm run build && publint && attw --pack . --profile esm-only",
    "clean": "rimraf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm run build",
    "prepare": "husky",
    "release": "release-it",
    "renovate:validate": "pnpm dlx --allow-build=re2 --package=renovate renovate-config-validator --strict",
    "test": "vitest run --typecheck.only",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@armscye/core": "^0.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.3.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "release-it": "21.1.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
